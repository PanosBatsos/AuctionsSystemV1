{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "PrivateKey": "${JWT_PRIVATE_KEY}",
    "PublicKey": "${JWT_PUBLIC_KEY}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpirationMinutes": "15"
  },
  "AllowedHosts": "*"
}
